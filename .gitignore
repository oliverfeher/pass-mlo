# ---- Dependencies ----
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins

# ---- Next.js / build output ----
/.next/
/out/
/build
/dist
*.tsbuildinfo

# ---- Environment (NEVER commit real keys) ----
# Ignore all env files EXCEPT the committed template.
.env
.env.*
!.env.example

# ---- Secrets / keys (belt and suspenders) ----
*.pem
*.key
service-account*.json
secrets*.json

# ---- Python (content pipeline) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.python-version

# ---- Deploy / tooling ----
/.vercel
/.turbo

# ---- Supabase CLI (if used locally) ----
/supabase/.branches
/supabase/.temp

# ---- Logs & debug ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ---- Test / coverage ----
/coverage
/.nyc_output

# ---- Editor / OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
*.swp
*~