# Copy to .env and fill in real values. NEVER commit .env (it's gitignored).
# The app expects legacy JWT-style Supabase keys in these slots
# (new sb_publishable_/sb_secret_ keys also work as drop-ins).

# ---- Supabase ----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# ---- Stripe ----
# Only needed for the purchase flow; placeholders are fine for local dev.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_STRIPE_PRICE_ID=price_placeholder
